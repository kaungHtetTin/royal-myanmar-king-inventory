APP_NAME="Stock & Inventory Management"
APP_ENV=production
APP_KEY=<generate-with-php-artisan-key-generate>
APP_DEBUG=false
APP_URL=https://inventory.example.com/company/inventory
APP_VERSION=1.0.0
DEPLOYMENT_ID=<release-date-and-commit>
APP_TIMEZONE=Asia/Yangon
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=<private-database-host>
DB_PORT=3306
DB_DATABASE=inventory
DB_USERNAME=<secret-manager-reference>
DB_PASSWORD=<secret-manager-reference>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/company/inventory
SESSION_DOMAIN=inventory.example.com
CORS_ALLOWED_ORIGINS=https://inventory.example.com

CACHE_STORE=database
QUEUE_CONNECTION=database
APP_MAINTENANCE_DRIVER=file

SUPER_ADMIN_NAME=<named-initial-administrator>
SUPER_ADMIN_USERNAME=<unique-administrator-username>
SUPER_ADMIN_EMAIL=<administrator-email>
SUPER_ADMIN_PASSWORD=<one-time-secret-manager-value>

APP_PREVIOUS_KEYS=
MYSQLDUMP_BINARY=/usr/bin/mysqldump
MYSQL_BINARY=/usr/bin/mysql
BACKUP_DIRECTORY=/secure/inventory/backups
BACKUP_MAXIMUM_AGE_HOURS=26
BACKUP_RETENTION_DAYS=30
BACKUP_OFFSITE_DESTINATION=<encrypted-off-host-location>

BUSINESS_OWNER_CONTACT=<name-and-supported-contact-channel>
TECHNICAL_OWNER_CONTACT=<name-and-supported-contact-channel>
SECURITY_CONTACT=<name-and-supported-contact-channel>
INCIDENT_PRIMARY_CONTACT=<name-and-supported-contact-channel>
INCIDENT_ESCALATION_CONTACT=<name-and-supported-contact-channel>
DATABASE_RECOVERY_OWNER=<name-and-supported-contact-channel>

PILOT_WAREHOUSE_CODE=<approved-warehouse-code>
PILOT_REPRESENTATIVE_CODE=<approved-representative-code>
ROLLOUT_SIGNOFF_EVIDENCE=/secure/inventory/rollout/phase9-signoff.json
